# ===== Obol (Python brain) =====
# Secrets live in sidecar/.env (the only place a private key belongs). The Python side
# only needs to know where the sidecar is and, optionally, the Anthropic eval model.

OBOL_SIDECAR_URL=http://127.0.0.1:8401
OBOL_START_BALANCE=1            # fallback if /balance can't report remaining

# Eval LLM (optional, wallet-adjacent -> Anthropic ONLY)
OBOL_EVAL_MODEL=
ANTHROPIC_API_KEY=

# Explorer base for reputation tx links (reputation writes are real Arc txs)
ARC_EXPLORER=https://testnet.arcscan.app/tx/
