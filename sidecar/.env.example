# Obol sidecar -- Arc MAINNET. The only place the agent key lives.
# chmod 600 .env   (never commit it; .gitignore covers it)

# Fresh hot key for Obol ONLY (cast wallet new). Keep <= ~10 USDC on it.
BUYER_PRIVATE_KEY=0x...

# Arc mainnet RPC (chain 5042). Alternatives: https://rpc.drpc.mainnet.arc.io,
# https://rpc.quicknode.mainnet.arc.io, https://rpc.blockdaemon.mainnet.arc.io
ARC_RPC=https://rpc.mainnet.arc.io

# ReputationRegistry v2 address after `forge create` (see docs/MAINNET.md)
REPUTATION_CONTRACT=

# Guardrails
OBOL_MAX_PRICE=0.01        # USDC per call, hard cap
OBOL_SPEND_LIMIT=1.0       # USDC lifetime, persisted in spend-ledger.json
PROVIDERS_FILE=../config/providers.mainnet.yaml
SIDECAR_PORT=8401
