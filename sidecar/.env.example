# Obol sidecar (chain gateway) -- the only place a private key lives.
SIDECAR_PORT=8401

# Circle Gateway buyer wallet (generated by `npm run generate-wallets` in the
# arc-nanopayments reference, or any funded Arc testnet EVM key).
BUYER_PRIVATE_KEY=0x...
ARC_CHAIN_NAME=arcTestnet

# Arc testnet RPC + chain id (for the ReputationRegistry tx via viem).
ARC_RPC=
ARC_CHAIN_ID=
REPUTATION_CONTRACT=

# Optional hard spend cap (USDC). The sidecar refuses /pay past this.
OBOL_SPEND_LIMIT=2.0
